# ==============================================================================
# TRADING AI AGENT SKILLS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# 1. DO NOT commit this file as '.env' to public repositories.
# 2. Never expose API keys or secrets to the client-side/frontend.
# 3. All execution calls require explicit Human-in-the-Loop user approval.
# ==============================================================================

# Execution Mode: 'paper' (default safe mode) or 'live'
EXECUTION_MODE=paper

# Approval Channel: 'terminal', 'web', or 'telegram'
APPROVAL_CHANNEL=terminal

# --- TELEGRAM BOT INTEGRATION (Optional: For remote approvals & alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- BROWSER REMOTE ATTACHING (Chrome DevTools Protocol) ---
# Default Chrome remote debugging port for attaching to existing sessions
CHROME_DEBUG_PORT=9222
CHROME_DEBUG_HOST=127.0.0.1

# --- MULTI-MARKET API KEYS (Optional: Free tiers supported) ---
# Yahoo Finance: Works out-of-the-box (no API key needed)
# AlphaVantage (Optional for enhanced forex/macro data):
ALPHA_VANTAGE_API_KEY=

# Crypto Exchange (CCXT - Optional for live balance & execution):
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- GOOGLE RESEARCH TIMESFM CONFIGURATION ---
# Execution Device: 'auto', 'cuda' (NVIDIA GPU), or 'cpu'
TIMESFM_DEVICE=auto
TIMESFM_MODEL_CHECKPOINT=google/timesfm-2.0-500m-pytorch
TIMESFM_CONTEXT_LEN=512
TIMESFM_HORIZON_LEN=32

# --- RISK MANAGEMENT PROTOCOLS ---
MAX_RISK_PER_TRADE_PERCENT=1.5
MAX_DAILY_DRAWDOWN_PERCENT=5.0
DEFAULT_TRAILING_STOP_PERCENT=2.0
ANTI_SLIPPAGE_MAX_SPREAD_PIPS=5.0

# --- LOCAL DATABASE & CACHE ---
SQLITE_DB_PATH=./data/trading_platform.db
EXCEL_EXPORT_DIR=./reports/excel_journals
